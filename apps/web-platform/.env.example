# apps/web-platform/.env.example — 복사해서 .env.local 을 만들고 값을 채우세요 (.env.local은 git에 올라가지 않음)
# VITE_ 로 시작하는 값은 빌드된 화면 코드에 그대로 들어가 누구나 볼 수 있음 → 비밀 값은 절대 넣지 않음

# 백엔드 주소 (비우면 http://localhost:8000)
VITE_API_URL=http://localhost:8000

# 병원 관계자 로그인 뒤 이동할 시연용 대시보드(dashboard/대시보드.html) 주소 (docs/dashboard-integration.md "시연용 대시보드 연결")
#   비우면 같은 사이트의 /dashboard(통계 대시보드)로 이동
VITE_DASHBOARD_URL=http://localhost:5175/대시보드.html

# 실시간 알림 (Supabase Realtime, 결정 27) — 비우면 알림은 60초마다 확인
#   URL은 백엔드가 알려 주므로 여기서는 공개 키만. Supabase 대시보드 > Project Settings > API Keys > Publishable key
#   공개 키(sb_publishable_…)만 — 비밀 키(sb_secret_…)·JWT 비밀 값은 절대 X (백엔드 .env 전용)
VITE_SUPABASE_PUBLISHABLE_KEY=
