# .env.example — 이 파일을 복사해 .env를 만들고 값을 채우세요 (.env는 git에 올라가지 않음)
DATA_GO_KR_SERVICE_KEY=

# LLM (ai/llm/config.py에서 읽음) — 데모는 가상 데이터만 사용
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_CHATBOT=
LLM_MODEL_AGENT=

# 백엔드 JWT (backend/src/core/config.py에서 읽음) — 값은 `openssl rand -hex 32` 등으로 각자 생성
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_PATIENT_EXPIRE_MINUTES=1440
JWT_STAFF_EXPIRE_MINUTES=480

# DB (backend/src/core/config.py) — Supabase 대시보드 위쪽 [Connect] > Connection string 에서 복사
#   postgresql://postgres.<프로젝트ID>:<DB비밀번호>@<풀러주소>:6543/postgres  (postgresql:// 그대로 넣어도 됨)
#   ⚠️ Project URL(https://….supabase.co)이 아님. 비밀번호의 특수문자(@ : / # ?)는 URL 인코딩
#   앱(Vercel): 트랜잭션 풀러 (포트 6543)
#   마이그레이션(alembic): 세션 풀러 (포트 5432) — 실행할 때만 이 값으로 바꾸거나 같은 값 사용
DATABASE_URL=

# 환율 (backend/src/modules/fx) — 한국은행 경제통계시스템 ecos.bok.or.kr > Open API > 인증키 신청
ECOS_API_KEY=
# FX_SWITCH_HOUR_KST=10   # 매일 이 시각(한국 시간)에 그날 적용 환율로 바뀜
