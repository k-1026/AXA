# .env.example — 이 파일을 복사해 .env를 만들고 값을 채우세요 (.env는 git에 올라가지 않음)
DATA_GO_KR_SERVICE_KEY=

# LLM (ai/llm/config.py에서 읽음) — 무료 등급은 입력이 기록될 수 있어 가상 데이터만 사용
# 앞 제공자가 한도 초과(429)·장애면 다음 제공자로 자동 전환. 키가 빈 제공자는 건너뜀
LLM_PROVIDER_ORDER=gemini,nemotron
GEMINI_API_KEY=
# 쉼표로 여러 모델 가능 (앞 모델 한도 초과 시 다음 모델). 비우면 config.py 기본값
# 무료 키는 모델별 하루 한도가 있음 (gemini-3.5-flash 20회/일, 2026-11-10 확인)
GEMINI_MODEL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=
# 비우면 사용량은 메모리에만 기록. 예: data/logs/llm_usage.jsonl
LLM_USAGE_LOG_PATH=

# 백엔드 JWT (backend/src/core/config.py에서 읽음) — 값은 `openssl rand -hex 32` 등으로 각자 생성
JWT_SECRET=
JWT_PATIENT_EXPIRE_MINUTES=1440
JWT_STAFF_EXPIRE_MINUTES=480

# 정기 정리 API /api/v1/internal/purge 비밀값 (16자 이상, 비우면 API가 꺼짐). 예약 작업이 Authorization: Bearer <값>으로 하루 1번 부름
CRON_SECRET=

# DB (backend/src/core/config.py) — Supabase 대시보드 위쪽 [Connect] > Connection string 에서 복사
#   postgresql://postgres.<프로젝트ID>:<DB비밀번호>@<풀러주소>:6543/postgres  (postgresql:// 그대로 넣어도 됨)
#   ⚠️ Project URL(https://….supabase.co)이 아님. 비밀번호의 특수문자(@ : / # ?)는 URL 인코딩
#   앱(Vercel): 트랜잭션 풀러 (포트 6543)
#   마이그레이션(alembic): 세션 풀러 (포트 5432) — 실행할 때만 이 값으로 바꾸거나 같은 값 사용
DATABASE_URL=

# 프론트 주소 (CORS) — JSON 목록. 비우면 로컬 기본값 (5403·5173). 대시보드(5175)를 쓰면 넣어야 함
# CORS_ORIGINS=["http://localhost:5173","http://localhost:5175"]

# 환율 (backend/src/modules/fx) — 한국은행 경제통계시스템 ecos.bok.or.kr > Open API > 인증키 신청
ECOS_API_KEY=
# FX_SWITCH_HOUR_KST=10   # 매일 이 시각(한국 시간)에 그날 적용 환율로 바뀜

# Supabase (Storage·Realtime) — Supabase 대시보드 > Project Settings
#   SUPABASE_URL = https://<프로젝트 ref>.supabase.co  (DATABASE_URL과 다름)
#   SUPABASE_SERVICE_ROLE_KEY = API Keys > Secret keys 의 sb_secret_… (예전 형식 service_role도 됨)
#     ⚠️ 공개 키(sb_publishable_…)를 넣으면 안 됨. 서버 전용 — 프론트·채팅·커밋에 X
#     비우면 사후관리 사진·영상은 "사진 있음" 표시만 (결정 22)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#   SUPABASE_JWT_SECRET = JWT Keys > Legacy JWT Secret (HS256). 서버 전용
#     백엔드가 환자에게 짧은 Realtime 토큰을 만들어 줄 때 씀 → 환자 웹이 자기 알림만 실시간으로 받음 (결정 27)
#     비우면 알림은 실시간 없이 주기적으로만 확인
SUPABASE_JWT_SECRET=
# 웹 푸시 (결정 30) — `uv run --no-sync python backend/scripts/make_vapid_keys.py`로 만든 두 줄. 서버 전용(공개 키는 API로 줌)
#   비우면 웹 푸시는 꺼지고 사이트 안 알림만. 키를 바꾸면 기존 구독은 다시 해야 함
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 주소 (운영 때 팀 공용 주소로)
VAPID_SUBJECT=mailto:noreply@example.com
