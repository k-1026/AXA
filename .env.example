# .env.example — 이 파일을 복사해 .env를 만들고 값을 채우세요 (.env는 git에 올라가지 않음)
DATA_GO_KR_SERVICE_KEY=

# LLM (ai/llm/config.py에서 읽음) — 무료 등급은 입력이 기록될 수 있어 가상 데이터만 사용
# 앞 제공자가 한도 초과(429)·장애면 다음 제공자로 자동 전환. 키가 빈 제공자는 건너뜀
LLM_PROVIDER_ORDER=gemini,nemotron
GEMINI_API_KEY=
# 쉼표로 여러 모델 가능 (앞 모델 한도 초과 시 다음 모델). 비우면 config.py 기본값
# 무료 키는 모델별 하루 한도가 있음 (gemini-3.5-flash 20회/일, 2026-11-10 확인)
GEMINI_MODEL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=
# 비우면 사용량은 메모리에만 기록. 예: data/logs/llm_usage.jsonl
LLM_USAGE_LOG_PATH=

# 백엔드 JWT (backend/src/core/config.py에서 읽음) — 값은 `openssl rand -hex 32` 등으로 각자 생성
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_PATIENT_EXPIRE_MINUTES=1440
JWT_STAFF_EXPIRE_MINUTES=480
